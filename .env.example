# GeneAI Research - Environment Variables Template
# Copy this file to .env.staging or .env.production and fill in values

# Application
GENEAI_ENV=staging
GENEAI_DATABASE_PATH=/app/data/geneai.db
GENEAI_LOG_LEVEL=INFO
GENEAI_LOG_PATH=/app/logs/geneai.log

# Database (PostgreSQL)
POSTGRES_DB=geneai
POSTGRES_USER=geneai
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
SECRET_KEY=changeme_very_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=changeme_32_byte_base64_encoded_key

# API
API_RATE_LIMIT=1000
API_KEY_PREFIX=gai_

# External APIs (optional - for enhanced features)
NCBI_API_KEY=
CHEMLB_API_KEY=
UNIPROT_API_KEY=
ALPHAFOLD_API_KEY=
OPENTARGETS_API_KEY=

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=GeneAI Research <notifications@example.com>

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_ENDPOINT=
GRAFANA_ENDPOINT=

# Cloud (optional - for Phase 5.6)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Feature Flags
ENABLE_MULTI_USER=true
ENABLE_REST_API=true
ENABLE_CLOUD_INTEGRATION=false
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_AUDIT_LOGGING=true

# Performance
CACHE_TTL_SECONDS=300
MAX_CONCURRENT_JOBS=10
WORKER_PROCESSES=4