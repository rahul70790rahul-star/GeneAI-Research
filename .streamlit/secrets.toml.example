# GeneAI Research - Streamlit Community Cloud Secrets Template
# Copy this file to .streamlit/secrets.toml in Streamlit Community Cloud dashboard
# NEVER commit actual secrets to GitHub!

# ============================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ============================================================
[database]
# Neon PostgreSQL connection string
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Get from Neon Dashboard → Connection Details
url = "postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/geneai?sslmode=require"

# Connection pool settings (adjust for Neon Free tier limits)
pool_size = 5
max_overflow = 10
pool_timeout = 30
pool_recycle = 1800

# ============================================================
# REDIS CONFIGURATION (Upstash)
# ============================================================
[redis]
# Upstash Redis REST API URL (for serverless)
# Format: https://xxx.upstash.io
# Get from Upstash Console → REST API
url = "https://xxx.upstash.io"

# Upstash Redis REST API Token
# Get from Upstash Console → REST API
token = "your-upstash-token"

# Alternative: Standard Redis URL (if using Redis client)
# Format: rediss://:password@xxx.upstash.io:6379
# standard_url = "rediss://:password@xxx.upstash.io:6379"

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
[app]
environment = "production"
debug = false
log_level = "INFO"

# Base URL for API calls (Render FastAPI service)
# Format: https://your-service-name.onrender.com
api_base_url = "https://geneai-api.onrender.com"

# Streamlit server config
server_port = 8501
server_address = "0.0.0.0"
server_headless = true
server_enable_cors = true
server_enable_xsrf_protection = true

# ============================================================
# SECURITY CONFIGURATION
# ============================================================
[security]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
secret_key = "your-32-char-secret-key-here"

# JWT Configuration
jwt_algorithm = "HS256"
jwt_expiration_hours = 24

# API Key prefix for REST API
api_key_prefix = "gai_"

# Encryption key for sensitive data (base64 encoded 32 bytes)
# Generate with: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
encryption_key = "your-base64-encoded-32-byte-key"

# ============================================================
# EXTERNAL API KEYS (Optional - for enhanced features)
# ============================================================
[external_apis]
# NCBI/E-utilities API key (optional - increases rate limit)
# Get from: https://www.ncbi.nlm.nih.gov/account/settings/
ncbi_api_key = ""

# UniProt API key (optional)
# Get from: https://www.uniprot.org/account/api-keys
uniprot_api_key = ""

# OpenTargets API key (optional)
# Get from: https://platform.opentargets.org/
opentargets_api_key = ""

# AlphaFold API key (optional)
# Get from: https://alphafold.ebi.ac.uk/
alphafold_api_key = ""

# ============================================================
# FEATURE FLAGS
# ============================================================
[features]
enable_multi_user = true
enable_rest_api = true
enable_cloud_integration = false
enable_advanced_analytics = true
enable_audit_logging = true
enable_mutation_ml = true

# ============================================================
# ML MODEL CONFIGURATION
# ============================================================
[ml_models]
# Path to trained models (relative to app)
model_dir = "data/models"

# Default model to load on startup
default_model = "best_mutation_model_real.pkl"

# Enable SHAP explanations
enable_shap = true

# ============================================================
# PERFORMANCE SETTINGS
# ============================================================
[performance]
cache_ttl_seconds = 300
max_concurrent_jobs = 5
worker_processes = 2